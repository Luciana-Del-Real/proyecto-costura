generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Conexión directa/session (sin pooler) usada por `prisma migrate` y por
  // Prisma Studio. Obligatoria cuando DATABASE_URL apunta a un pooler
  // (ej. Supabase): las migraciones no pueden pasar por el pooler.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  ALUMNO
}

enum CourseLevel {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADO
}

enum PurchaseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CertificateRequestStatus {
  PENDING
  SENT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  country   String   @default("ARS")
  role          Role      @default(ALUMNO)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  purchases      Purchase[]
  progress       LessonProgress[]
  favorites      Favorite[]
  notifications  Notification[]
  passwordResetTokens PasswordResetToken[]
  lessonComments LessonComment[]
  pushSubscriptions PushSubscription[]
  certificateRequests CertificateRequest[]
  patternPurchases PatternPurchase[]

  @@map("users")
}

  model Course {
    id                String    @id @default(cuid())
    title             String
    description       String
    longDescription   String?
    image             String?
    pdfGuide          String?
    priceARS          Float     @default(0)
    priceAUD          Float     @default(0)
    level             CourseLevel @default(PRINCIPIANTE)
    instructor        String?
    duration          String?
    featured          Boolean   @default(false)
    rating            Float     @default(5.0)
    students          Int       @default(0)
    active            Boolean   @default(true)
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt

    lessons           Lesson[]
    purchases         Purchase[]
    favorites         Favorite[]
    attachments       Attachment[]
    certificateRequests CertificateRequest[]

    @@map("courses")
  }

  model Lesson {
    id        String   @id @default(cuid())
    title     String
    description String?
    duration  String
    videoUrl  String
    pdf       String?
    order     Int
    courseId  String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
    progress LessonProgress[]
    attachments Attachment[]
    comments LessonComment[]

    @@unique([courseId, order])
    @@map("lessons")
  }

  model LessonComment {
    id        String   @id @default(cuid())
    message   String
    lessonId  String
    userId    String
    parentId  String?
    image     String?
    createdAt DateTime @default(now())

    lesson  Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
    user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    parent  LessonComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
    replies LessonComment[] @relation("CommentReplies")

    @@index([lessonId, createdAt])
    @@map("lesson_comments")
  }

  model LessonProgress {
    id        String   @id @default(cuid())
    userId    String
    lessonId  String
    completed Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

    @@unique([userId, lessonId])
    @@map("lesson_progress")
  }

  model Purchase {
    id        String    @id @default(cuid())
    userId    String
    courseId  String
    status    PurchaseStatus @default(PENDING)
    deletedAt DateTime?
    total     Float
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    // Eliminada la eliminación en cascada por seguridad contable.
    // Se usa borrado lógico a través de `deletedAt`.
    user   User   @relation(fields: [userId], references: [id])
    course Course @relation(fields: [courseId], references: [id])

    @@unique([userId, courseId])
    @@map("purchases")
  }

model CertificateRequest {
  id        String                    @id @default(cuid())
  userId    String
  courseId  String
  status    CertificateRequestStatus  @default(PENDING)
  createdAt DateTime                  @default(now())
  sentAt    DateTime?

  // El certificado lo arma y envía la profesora fuera de la app; acá solo se
  // registra la solicitud de la alumna y su estado (PENDING -> SENT).
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Máximo UNA solicitud por alumna y curso: re-pedir actualiza la existente.
  @@unique([userId, courseId])
  @@map("certificate_requests")
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  url       String
  createdAt DateTime @default(now())
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  patternId String?
  pattern   Pattern? @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("favorites")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Pattern {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String
  nivel       String   @default("Principiante")
  categoria   String   @default("")
  imagen      String?
  archivo     String?
  precioARS   Float    @default(0)
  precioAUD   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments       Attachment[]
  patternPurchases  PatternPurchase[]

  @@map("patterns")
}

// Solicitud de compra de un patrón de pago (mismo flujo que las compras de
// cursos: la alumna solicita, el admin aprueba y se desbloquea el PDF).
model PatternPurchase {
  id        String         @id @default(cuid())
  userId    String
  patternId String
  status    PurchaseStatus @default(PENDING)
  total     Float
  deletedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  pattern Pattern @relation(fields: [patternId], references: [id])

  @@unique([userId, patternId])
  @@map("pattern_purchases")
}

// Eventos de la página pública (folletos). El admin sube la IMAGEN del
// folleto diseñado a mano; los campos de texto quedan como respaldo/legacy
// para folletos que todavía no tienen imagen propia. `order` define la
// posición en la grilla y `active` si se muestra en la web.
model Event {
  id        String   @id @default(cuid())
  title     String?
  subtitle  String?
  detail    String?
  waMessage String?
  image     String?
  icon      String   @default("Sparkles")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}
