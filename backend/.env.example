# Base de datos - PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base_datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/costura_app"

# JWT — REQUIRED: the backend refuses to boot without it (fail-fast, no fallback)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRATION="24h"

# Api
NODE_ENV="development"
PORT=3000
API_PREFIX="/api"

# CORS
# Lista de orígenes permitidos separados por coma (dev: 5173/5174/5175)
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Frontend — origen público usado en los enlaces de los emails (ej. reset de contraseña)
FRONTEND_URL="http://localhost:5173"

# Admin — used by npm run db:seed / db:create-admin only; no defaults, bcrypt-only
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_NAME="Admin"

# Email (SendGrid) — sending is OFF by default; set MAIL_ENABLED to "true" to enable
MAIL_ENABLED="false"
# SENDGRID_API_KEY — required when MAIL_ENABLED="true" (fail-fast if missing)
SENDGRID_API_KEY=""
# SENDGRID_FROM — remitente de los correos transaccionales
SENDGRID_FROM="no-reply@example.com"
